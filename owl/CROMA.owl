    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/CROMA.owl#Action_Designator_Design -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/CROMA.owl#Action_Designator_Design">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/CROMA.owl#Designator_Design"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#describes"/>
                <owl:someValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Action Designator Design</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/CROMA.owl#Board -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/CROMA.owl#Board">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#DesignedTool"/>
        <rdfs:comment>A board is a flat piece of wood or other hard material. (PhysicalObject)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/CROMA.owl#CRAM_Cognitive_Architecture -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/CROMA.owl#CRAM_Cognitive_Architecture">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Software_Configuration"/>
        <rdfs:label xml:lang="en">CRAM Cognitive Architecture</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/CROMA.owl#CRAM_Designator -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/CROMA.owl#CRAM_Designator">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/CROMA.owl#Designator"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/CROMA.owl#resolved_to"/>
                <owl:someValuesFrom rdf:resource="http://www.ease-crc.org/ont/CROMA.owl#CRAM_Designator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">CRAM Designator</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/CROMA.owl#CRAM_Plan -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/CROMA.owl#CRAM_Plan">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#ActionExecutionPlan"/>
        <rdfs:label>CRAM Plan</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/CROMA.owl#CuttingTool -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/CROMA.owl#CuttingTool">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#DesignedTool"/>
        <rdfs:comment>A tool that is used for cutting, for example knife. (Should reference cuttlery)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/CROMA.owl#Designator -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/CROMA.owl#Designator">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject"/>
        <rdfs:comment xml:lang="en">Designator</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/CROMA.owl#Designator_Design -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/CROMA.owl#Designator_Design">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Design"/>
        <rdfs:label xml:lang="en">Designator Design</rdfs:label>
    </owl:Class>
    
    <!-- http://www.ease-crc.org/ont/CROMA.owl#KeepJointStates -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/CROMA.owl#KeepJointStates">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Parameter"/>
        <rdfs:comment>KeepJointStates is a parameter from PyCRAM with the values True or False. True means, that the robot keeps the position of the body while navigating, False would imply that the robot is allowed to e.g. move the arms while navigating.</rdfs:comment>
    </owl:Class>

    <!-- http://www.ease-crc.org/ont/CROMA.owl#DestinationPose -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/CROMA.owl#DestinationPose">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Setpoint"/>
        <rdfs:comment>Describes the pose which is the destination/goal of a current action</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/CROMA.owl#LocationDesignator -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/CROMA.owl#LocationDesignator">
