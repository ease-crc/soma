     -->

    


    <!-- http://www.ease-crc.org/ont/CROMA.owl#ActionDesignator -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/CROMA.owl#ActionDesignator">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/CROMA.owl#CRAM_Designator"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#expresses"/>
                <owl:someValuesFrom rdf:resource="http://www.ease-crc.org/ont/CROMA.owl#Action_Designator_Design"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Action Designator</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/CROMA.owl#ActionDesignatorDescription -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/CROMA.owl#ActionDesignatorDescription">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/CROMA.owl#ActionDesignator"/>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/CROMA.owl#ActionDesignatorPerformed -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/CROMA.owl#ActionDesignatorPerformed">
