    <!-- http://www.ease-crc.org/ont/CROMA.owl#ObjectDesignator -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/CROMA.owl#ObjectDesignator">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/CROMA.owl#CRAM_Designator"/>
        <rdfs:subClassOf>
            <owl:Restriction>
