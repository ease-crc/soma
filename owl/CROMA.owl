    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/CROMA.owl#Object_Designator_Design -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/CROMA.owl#Object_Designator_Design">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/CROMA.owl#Designator_Design"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#describes"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#PhysicalObject"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Object Designator Design</rdfs:label>
    </owl:Class>
    


