            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Location Designator Design</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/CROMA.owl#MixingTool -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/CROMA.owl#MixingTool">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#DesignedTool"/>
        <rdfs:comment>A tool that is used for mixing, for example whisk. (PhysicalObject)</rdfs:comment>
    </owl:Class>
    


