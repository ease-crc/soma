    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ease-crc.org/ont/CROMA.owl#hasKey -->

    <owl:DatatypeProperty rdf:about="http://www.ease-crc.org/ont/CROMA.owl#hasKey">
        <rdfs:subPropertyOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasPersistentIdentifier"/>
    </owl:DatatypeProperty>
    


