    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/CROMA.owl#ActionDesignatorResolved -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/CROMA.owl#ActionDesignatorResolved">
