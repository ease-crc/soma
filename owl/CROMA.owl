    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/CROMA.owl#ObjectDesignatorResolved -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/CROMA.owl#ObjectDesignatorResolved">
